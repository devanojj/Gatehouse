# Database ----------------------------------------------------------------
# For local development you can point at a plain SQLite file — no Turso
# account needed:
#
#   TURSO_DATABASE_URL=file:./gatehouse.db
#
# For a real (hosted) database, create one with the Turso CLI:
#
#   turso db create gatehouse
#   turso db show gatehouse --url
#   turso db tokens create gatehouse
#
TURSO_DATABASE_URL=libsql://gatehouse-xxxxx.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Email -------------------------------------------------------------------
# Optional. Leave both unset and magic links are printed to the server
# console instead of emailed — the app is fully usable that way, with no
# domain or email provider configured.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="Gatehouse <login@yourdomain.com>"

# Used to build absolute magic-link URLs. Defaults to http://localhost:3000.
# APP_URL=https://gatehouse.yourdomain.com
