# Database ----------------------------------------------------------------
# For local development you can point at a plain SQLite file — no Turso
# account needed:
#
#   TURSO_DATABASE_URL=file:./gatehouse.db
#
# For a real (hosted) database, create one with the Turso CLI:
#
#   turso db create gatehouse
#   turso db show gatehouse --url
#   turso db tokens create gatehouse
#
TURSO_DATABASE_URL=libsql://gatehouse-xxxxx.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Email -------------------------------------------------------------------
# Optional. Leave both unset and magic links are printed to the server
# console instead of emailed — the app is fully usable that way, with no
# domain or email provider configured.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="Gatehouse <login@yourdomain.com>"

# Used to build absolute magic-link URLs. Defaults to http://localhost:3000.
# APP_URL=https://gatehouse.yourdomain.com

# Inbound email ------------------------------------------------------------
# Optional. One shared mailbox receives every organization's support mail; the
# `+slug` on the address is what routes a message to the right tenant. Leave
# these unset and Settings → Inbox explains what is missing instead of failing.
#
# Use a Google App Password (https://support.google.com/accounts/answer/185833),
# not the account password, and turn IMAP on for the mailbox. Google shows it as
# four groups of four letters; paste it here with or without the spaces.
# GMAIL_USER=your-shared-inbox@gmail.com
# GMAIL_APP_PASSWORD=your-google-app-password

# Only needed for a non-Gmail mailbox.
# INBOUND_IMAP_HOST=imap.gmail.com
# INBOUND_IMAP_PORT=993

# Scheduled inbound polling ------------------------------------------------
# Optional. With this set, /api/cron/inbound accepts a request carrying
# `Authorization: Bearer <CRON_SECRET>` and polls every organization's mail.
# Vercel Cron sends exactly that header when the project has a CRON_SECRET
# environment variable, and vercel.json already schedules the route every
# fifteen minutes. Without the variable the route refuses every request, and
# Settings → Inbox keeps working as a manual button.
#
# Use a long random value: `openssl rand -hex 32`.
# CRON_SECRET=

# Attachments --------------------------------------------------------------
# Optional in development. With no S3 variables set, uploaded files are written
# to a directory on disk (ATTACHMENTS_DIR, default ./.gatehouse-uploads) so the
# whole feature works locally with no credentials. That fallback is refused in
# production, where a serverless filesystem does not survive the request.
#
# Any S3-compatible bucket works — AWS S3, Cloudflare R2, MinIO, DigitalOcean
# Spaces. All three of BUCKET, ACCESS_KEY_ID and SECRET_ACCESS_KEY must be set
# for the bucket to be used.
# S3_BUCKET=gatehouse-attachments
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Only for a bucket that is not AWS S3 itself.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# Put the bucket in the path rather than the hostname. Needed by R2 and MinIO.
# S3_FORCE_PATH_STYLE=true

# Where the local fallback writes files. Ignored when a bucket is configured.
# ATTACHMENTS_DIR=.gatehouse-uploads
